{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/debpalash/omnivoice-gallery/schema/manifest.schema.json",
  "title": "VoiceStudio Gallery manifest",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "updated_at": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "item_ids"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "use_case", "facets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "type": { "type": "string", "enum": ["preset", "voice"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "icon": { "type": "string" },
          "use_case": {
            "type": "string",
            "enum": ["narration", "conversational", "characters", "social",
                     "entertainment", "advertisement", "informative"]
          },
          "facets": {
            "type": "object",
            "properties": {
              "gender": { "type": ["string", "null"] },
              "age": { "type": ["string", "null"] },
              "pitch": { "type": ["string", "null"] },
              "accent": { "type": ["string", "null"] },
              "whisper": { "type": "boolean" },
              "lang": { "type": "string" }
            }
          },
          "instruct": { "type": "string" },
          "language": { "type": "string" },
          "sample_script": { "type": "string" },
          "audio": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "ref_text": { "type": "string" },
              "duration": { "type": "number" },
              "sha256": { "type": "string" }
            }
          },
          "author": { "type": "string" },
          "license": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
